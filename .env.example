# 환경 변수 견본. 실제 값 파일(.env.local · .env.development 등)은 추적하지 않으므로,
# 새 키를 더하면 이 파일에도 키를 더해 공유한다. 값은 비워 둔다.

# whale-erp-api 주소. 로컬에서 api 는 8000 포트로 뜬다. 예) http://localhost:8000
API_BASE_URL=

# 개발용 관리자 토큰(개발 서버에서만 읽는다). 관리자 로그인이 생기면 지운다. 커밋하지 않는다.
API_DEV_TOKEN=

# 행정안전부 도로명주소 검색 API 승인키(business.juso.go.kr 에서 받는다). 서버에서만 읽는다.
# 비우면 주소 검색 층에 「지금은 주소를 검색할 수 없습니다」가 뜨고, 원인(키 없음)은 서버 로그에 남는다.
JUSO_API_KEY=

# 카카오 로컬 API REST 키(developers.kakao.com 앱 키, 앱에서 카카오맵 사용 설정을 켠다). 점포 주소를 고르면 위도 · 경도를 채운다. 서버에서만 읽는다.
KAKAO_REST_API_KEY=

# 플랫폼 관리자가 점포를 등록할 BP 의 bp_code_id(개발 DB 는 BP000007 · 8). DB 마다 다르니 환경마다 맞춰 적는다.
# 비우면 BP 를 싣지 않는다 — BP 계정은 소속 BP 로 등록되고, 플랫폼 관리자는 api 가 막는다. 관리자 로그인이 생기면 지운다.
STORE_REGISTER_BP_CODE_ID=
